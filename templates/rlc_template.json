{
  "name": "RLC Template",
  "description": "Template for Commercial Registry (Registro Mercantil) data extraction",
  "fields": {
    "denominacion_social": {
      "patterns": [
        "denominaci[óo]n[\\s:]*([A-Z][A-Za-z\\s,\\.]+[SL|SA|SLU])",
        "raz[óo]n\\s+social[\\s:]*([A-Z][A-Za-z\\s,\\.]+)",
        "company\\s+name[\\s:]*([A-Z][A-Za-z\\s,\\.]+)"
      ],
      "type": "string",
      "required": true
    },
    "cif": {
      "patterns": [
        "cif[\\s:]*([A-Z]\\d{7}[A-Z0-9])",
        "nif[\\s:]*([A-Z0-9]+)"
      ],
      "type": "string",
      "required": true
    },
    "tomo": {
      "patterns": [
        "tomo[\\s:]*([0-9]+)",
        "volume[\\s:]*([0-9]+)"
      ],
      "type": "string",
      "required": false
    },
    "folio": {
      "patterns": [
        "folio[\\s:]*([0-9]+)",
        "page[\\s:]*([0-9]+)"
      ],
      "type": "string",
      "required": false
    },
    "hoja": {
      "patterns": [
        "hoja[\\s:]*([A-Z]{1,3}-?[0-9]+)",
        "sheet[\\s:]*([A-Z0-9\\-]+)"
      ],
      "type": "string",
      "required": false
    },
    "inscripcion": {
      "patterns": [
        "inscripci[óo]n[\\s:]*([0-9]+)[ªa]?",
        "registration[\\s:]*([0-9]+)"
      ],
      "type": "string",
      "required": false
    },
    "fecha_constitucion": {
      "patterns": [
        "fecha\\s+de\\s+constituci[óo]n[\\s:]*(\\d{1,2}[\\/\\-\\.]\\d{1,2}[\\/\\-\\.]\\d{2,4})",
        "constituida\\s+el[\\s:]*(\\d{1,2}[\\/\\-\\.]\\d{1,2}[\\/\\-\\.]\\d{2,4})"
      ],
      "type": "date",
      "required": false
    }
  }
}
